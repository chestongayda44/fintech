# Copy to .env and fill in. .env is git-ignored and Claude is denied read access.

# --- Data ---
FRED_API_KEY=
DATA_SOURCE=gcs            # gcs | local  (flip to local if the network misbehaves)
ALLOW_SEED_FALLBACK=1      # laptops/notebooks only: use data/seed/ if FRED is down. Never in production.
GCS_BUCKET=fintechco-demo-macro
GCS_PREFIX=macro-credit-risk

# Python with the pipeline's packages (ops/ingest.sh uses it). Set to the output of: which python
PYTHON=

# --- Jupyter MCP ---
JUPYTER_URL=http://localhost:8888
JUPYTER_TOKEN=             # generate: python -c "import secrets; print(secrets.token_hex(16))"

# --- Data Science persona: Claude via Google Vertex AI ---
DS_PROVIDER=vertex         # vertex | bedrock  (use bedrock while Vertex quota is pending)
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=global

# --- SWE / SRE personas: Claude via Amazon Bedrock ---
AWS_PROFILE=default        # or your SSO profile name
AWS_REGION=us-east-1
